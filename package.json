{
  "name": "@processhub/design-system",
  "version": "0.2.2",
  "type": "module",
  "description": "ProcessHub design system: React components and CSS tokens.",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./components.css": "./dist/components.css",
    "./assets/*": "./assets/*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "DESIGN.md",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProcessHub-HQ/processhub-design-system.git"
  },
  "homepage": "https://github.com/ProcessHub-HQ/processhub-design-system#readme",
  "bugs": {
    "url": "https://github.com/ProcessHub-HQ/processhub-design-system/issues"
  }
}
